# Copy to ios/scripts/local.env (gitignored): what the scripts need to know about your Apple accounts. Nothing here
# is a secret; the App Store Connect key itself stays at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8.
# docs/SELF-HOSTING.md walks through each one.

# ---- scripts/testflight.sh and scripts/asc.mjs
TEAM_ID=YOURTEAMID            # Apple Developer team; the same as Local.xcconfig's DEVELOPMENT_TEAM
ORG_IDENTIFIER=com.example    # the app is $ORG_IDENTIFIER.Snip; the same as Local.xcconfig's ORG_IDENTIFIER
ASC_KEY_ID=YOURKEYID          # App Store Connect → Users and Access → Integrations → Team Keys, App Manager role
ASC_ISSUER=00000000-0000-0000-0000-000000000000

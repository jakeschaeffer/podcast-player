<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own Keychain group, shared with its extensions: the share sheet reads the server and the device
	     token the app keeps there (PodcastAPI's SharedSession and TokenStore). Needs nothing in the developer portal. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(ORG_IDENTIFIER).Snip</string>
	</array>
</dict>
</plist>

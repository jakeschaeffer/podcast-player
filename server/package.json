{
  "name": "@podcast-player/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API, worker, and core functions for the podcast player",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:update": "UPDATE_OPENAPI=1 vitest run test/openapi.test.ts",
    "api-fixtures:update": "UPDATE_API_FIXTURES=1 vitest run test/api-fixtures.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/index.ts --role all",
    "dev:api": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/index.ts --role api",
    "dev:worker": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/index.ts --role worker",
    "start": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local dist/src/index.js --role all",
    "transcribe": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/transcribe.ts",
    "drain": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/drain.ts",
    "eval:snips:build": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/evals/snip-selection/build-cases.ts",
    "eval:snips:run": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/evals/snip-selection/run.ts",
    "gmail:auth": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/gmail-auth.ts",
    "gmail:check": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/gmail-check.ts",
    "email:sync": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/email-sync.ts",
    "eval:text:compare": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/evals/transcription/compare.ts",
    "ads": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/ads.ts",
    "text:policy": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/cli/text-policy.ts",
    "eval:titles:build": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/evals/snip-titles/build-cases.ts",
    "eval:titles:run": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env.server.local --import tsx src/evals/snip-titles/run.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "domhandler": "^6.0.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "htmlparser2": "^12.0.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2",
    "ulid": "^3.0.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

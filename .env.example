# Server settings, read from .env.local (and, on a production host, .env.server.local) at the repository root.
# Copy to .env.local and fill in; both are gitignored. docs/SELF-HOSTING.md and server/README.md explain each one.
# scripts/dev-server.sh writes a .env.local of its own the first time and forces every paid service off.
APP_SECRET=
OWNER_PASSWORD=
PUBLIC_BASE_URL=
DATA_DIR=
SHARE_BY_NAME=
TEXT_MODEL=none
# Paid or account services: empty turns each off.
ELEVENLABS_API_KEY=
READWISE_TOKEN=
# Topic search over podcast transcripts (Exa Agent API with Particle). Every new search bills one Exa run.
EXA_API_KEY=
EXA_EFFORT=low
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
